{
	"name": "riddlon",
	"private": true,
	"version": "0.13.0",
	"type": "module",
	"scripts": {
		"predev": "npm run stories:bundle",
		"dev": "vite dev",
		"prebuild": "npm run stories:bundle",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"stories:validate": "node scripts/build-stories.mjs --check",
		"stories:build": "node scripts/build-stories.mjs",
		"stories:bundle": "node scripts/build-stories.mjs --static",
		"story:playtest": "node scripts/playtest-story.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.4",
		"@types/node": "^26",
		"@typescript/native": "npm:typescript@^7.0.2",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.0",
		"fake-indexeddb": "^6.2.7",
		"globals": "^17.14.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vitest": "^5.1.0"
	},
	"dependencies": {
		"@mlc-ai/web-llm": "0.2.87",
		"fflate": "^0.8.3",
		"idb": "^8.0.4",
		"zod": "^4.6.7"
	}
}
