{
	"name": "riddlon",
	"private": true,
	"version": "0.11.0",
	"type": "module",
	"scripts": {
		"predev": "npm run stories:bundle",
		"dev": "vite dev",
		"prebuild": "npm run stories:bundle",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"stories:validate": "node scripts/build-stories.mjs --check",
		"stories:build": "node scripts/build-stories.mjs",
		"stories:bundle": "node scripts/build-stories.mjs --static",
		"story:playtest": "node scripts/playtest-story.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^26",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.0",
		"fake-indexeddb": "^6.2.5",
		"globals": "^17.11.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.9",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.0",
		"typescript": "^7.0.2",
		"typescript-eslint": "^8.67.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.11"
	},
	"dependencies": {
		"@mlc-ai/web-llm": "0.2.84",
		"fflate": "^0.8.3",
		"idb": "^8.0.3",
		"zod": "^4.4.3"
	}
}
